# ───────────────────────────────────────────────────────────────────────
# AI Learning Platform — Environment Variables Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# ───────────────────────────────────────────────────────────────────────

# ── Server Configuration ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Secret key used for signing JSON Web Tokens.
# IMPORTANT: Generate a secure, unique, and long random string for production!
JWT_SECRET=ai_learn_super_secret_jwt_key_2025_change_in_prod
JWT_EXPIRES_IN=7d

# Allowed CORS origin(s) for backend access.
CLIENT_ORIGIN=http://localhost:5173

# ── Database Connection ────────────────────────────────────────────────
# PostgreSQL/MySQL/SQLite connection string used by Prisma.
# Replace with your local database URL or hosted instance credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_learning_platform

# ── Frontend Configuration ─────────────────────────────────────────────
# Base URL for the backend API endpoints. Used by Vite.
VITE_API_URL=http://localhost:5000/api
